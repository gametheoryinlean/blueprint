{
  "id": "zero_sum.minimax.minimax_theorem",
  "title": "Von Neumann Minimax Theorem",
  "kind": "theorem",
  "status": "staged",
  "href": "zero_sum/zero_sum_minimax_minimax_theorem.html",
  "primary_topic": "zero_sum",
