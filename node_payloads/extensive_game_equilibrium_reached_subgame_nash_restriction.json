{
  "id": "extensive_game.equilibrium.reached_subgame_nash_restriction",
  "title": "Reached Subgame Nash Restriction",
  "kind": "theorem",
  "status": "staged",
  "href": "extensive_game/equilibrium/extensive_game_equilibrium_reached_subgame_nash_restriction.html",
