{
  "id": "game_theory.extensive_game.perfect_information.spe_implies_nash",
  "title": "Subgame-Perfect Equilibrium Implies Nash Equilibrium",
  "kind": "proposition",
  "status": "formalized",
  "href": "game_theory/extensive_game/game_theory_extensive_game_perfect_information_spe_implies_nash.html",
