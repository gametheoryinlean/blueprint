{
  "id": "game_theory.strategic_game.zero_sum.examples.two_by_two_value_formula",
  "title": "Two-By-Two Value Formula",
  "kind": "example",
  "status": "formalized",
  "href": "game_theory/strategic_game/zero_sum/game_theory_strategic_game_zero_sum_examples_two_by_two_value_formula.html",
