{
  "id": "zero_sum.core.optimal_strategy_sets_are_polytopes",
  "title": "Optimal Strategy Sets Are Polytopes",
  "kind": "proposition",
  "status": "formalized",
  "href": "zero_sum/zero_sum_core_optimal_strategy_sets_are_polytopes.html",
  "primary_topic": "zero_sum",
