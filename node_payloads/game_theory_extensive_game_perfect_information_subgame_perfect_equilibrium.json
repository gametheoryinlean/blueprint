  "title": "Subgame-Perfect Equilibrium In Perfect-Information Games",
  "kind": "definition",
  "status": "formalized",
  "href": "game_theory/extensive_game/game_theory_extensive_game_perfect_information_subgame_perfect_equilibrium.html",
