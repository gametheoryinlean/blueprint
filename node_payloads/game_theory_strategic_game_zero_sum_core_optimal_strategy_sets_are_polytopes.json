{
  "id": "game_theory.strategic_game.zero_sum.core.optimal_strategy_sets_are_polytopes",
  "title": "Optimal Strategy Sets Are Polytopes",
  "kind": "proposition",
  "status": "formalized",
  "href": "game_theory/strategic_game/game_theory_strategic_game_zero_sum_core_optimal_strategy_sets_are_polytopes.html",
