{
  "id": "game_theory.strategic_game.evolution.evolutionarily_stable_strategy",
  "title": "Evolutionarily Stable Strategy",
  "kind": "definition",
  "status": "staged",
  "href": "game_theory/strategic_game/evolution/game_theory_strategic_game_evolution_evolutionarily_stable_strategy.html",
  "primary_topic": "game_theory.strategic_game.evolution",
