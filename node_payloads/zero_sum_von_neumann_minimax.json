{
  "id": "zero_sum.von_neumann_minimax",
  "title": "Von Neumann Minimax Theorem",
  "kind": "theorem",
  "status": "formalized",
  "href": "zero_sum/zero_sum_von_neumann_minimax.html",
  "primary_topic": "zero_sum",
  "topics": [
    "zero_sum",
    "zero_sum.minimax"
