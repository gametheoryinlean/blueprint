{
  "id": "zero_sum.minimax.minimax_from_loomis",
  "title": "Minimax via the All-Ones Specialization of Loomis",
  "kind": "proof-plan",
  "status": "formalized",
  "href": "zero_sum/zero_sum_minimax_minimax_from_loomis.html",
